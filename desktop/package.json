{
  "name": "climb-race-overlay",
  "version": "1.2.0",
  "description": "Climb race overlay for League of Legends",
  "main": "main.js",
  "author": "HoeschleY",
  "scripts": { "start": "electron .", "dist": "electron-builder --win portable --publish never" },
  "devDependencies": { "electron": "31.7.7", "electron-builder": "24.13.3" },
  "build": {
    "appId": "io.github.hoeschley.climbrace",
    "productName": "Climb Race Overlay",
    "files": ["main.js", "preload.js", "client.js", "icon.png"],
    "win": { "target": "portable", "icon": "icon.ico" },
    "portable": { "artifactName": "ClimbRaceOverlay.exe" }
  }
}
